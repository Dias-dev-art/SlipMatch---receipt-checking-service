ENV=dev
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/orderagent
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:3000
# how Telegram and the dashboard reach the backend (your ngrok https URL in dev)
PUBLIC_BASE_URL=http://localhost:8000

LLM_BASE_URL=https://api.runpod.ai/v2/<endpoint-id>/openai/v1
LLM_API_KEY=rpa_...
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# the bot customers order through: @BotFather -> /newbot (see docs/TELEGRAM_SETUP.md)
TELEGRAM_BOT_TOKEN=
# without @, e.g. WaitlyBot
TELEGRAM_BOT_USERNAME=
# any random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# shop_code for chats that open the bot without a shop link (demo: kak-ani-kitchen)
TELEGRAM_DEFAULT_SHOP=kak-ani-kitchen

NEXT_PUBLIC_API_URL=http://localhost:8000